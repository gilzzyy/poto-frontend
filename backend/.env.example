# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication (SEC-02)
JWT_SECRET=ganti_dengan_secret_jwt_minimal_32_karakter_acak
JWT_EXPIRES_IN=7d

# Supabase Server Credentials (SEC-03: HANYA di server, JANGAN pernah dikirim ke frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase Storage Buckets (Bab 5.4 & SEC-05)
SUPABASE_STRIPS_BUCKET=photo-strips
SUPABASE_CATALOG_BUCKET=katalog
SIGNED_URL_TTL_SECONDS=900
